{
  "name": "@sudobility/entity_client",
  "version": "0.0.56",
  "type": "module",
  "description": "Frontend client library for entity/organization management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "format": "bunx prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\""
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@sudobility/types": "^1.9.76"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/react": "~16.3.3",
    "@types/bun": "~1.4.4",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "jsdom": "~30.1.3",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "keywords": [
    "entity",
    "organization",
    "react",
    "hooks",
    "client"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/entity_client.git"
  }
}
